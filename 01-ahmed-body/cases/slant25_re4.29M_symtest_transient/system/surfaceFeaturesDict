FoamFile
{
    format      ascii;
    class       dictionary;
    object      surfaceFeaturesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaces ("ahmedBody.stl");

// Identify a feature when angle between faces < includedAngle.
// Catches the sharp slant/roof and side edges of the Ahmed body
// while ignoring the smoothly-tessellated front fillet.
includedAngle   150;

subsetFeatures
{
    nonManifoldEdges    yes;
    openEdges           yes;
}

