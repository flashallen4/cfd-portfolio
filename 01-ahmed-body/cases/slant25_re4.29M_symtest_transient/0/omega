FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "include/initialConditions"

dimensions      [0 0 -1 0 0 0 0];
internalField   uniform $turbulentOmega;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      $internalField;
        value           $internalField;
    }
    ground
    {
        type            omegaWallFunction;
        value           $internalField;
    }
    top
    {
        type            slip;
    }
    symmetryPlane
    {
        type            symmetryPlane;
    }
    farfield
    {
        type            slip;
    }
    ahmedBody
    {
        type            omegaWallFunction;
        value           $internalField;
    }
}
